# --- required ---
BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habarlandyru?schema=public
# numeric id (-100...) or @channelusername
CHANNEL_ID=
# Telegram user id of the moderator
ADMIN_ID=

# --- optional (defaults shown) ---
LOG_LEVEL=info
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
MAX_MESSAGE_LENGTH=1500
DUPLICATE_WINDOW_HOURS=24
AI_CONFIDENCE_THRESHOLD=0.7
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
RETRY_INTERVAL_SECONDS=60
MAX_ATTEMPTS=5
RETENTION_DAYS=30
NOTIFY_ADMIN_ON_REJECT=false
# always = every announcement with photos goes to manual review; auto = decided like text-only ones
PHOTO_REVIEW=always
# true = EVERY announcement goes to the admin before the author sees a preview
REVIEW_ALL=false
